BT /F1 9.07 Tf 68.03 521.23 Td (· fabricacion: {"propias":523,"fabricadas":172,"compradas":351,"conTolerancia":172,"conMaterial":153,"soldadas":35,"conCordon":35,"designadas":351,"deModulo":42,"sinDesignar":[],"avisosDesignacion":62,"genericas":[],"sinNorma":[],"diceSoldadaSinTabla":[],"juntasSinCota":[],"dispensas":[{"id":"MAT-01","esperadas":10,"dueño":"adapt/mod_calles.mjs \(pieza medida del cliente\)","motivo":"volante del cliente REUBICADO: del STEP salen el Ø y la cara útil, no el material. Hay que preguntárselo al cliente o medirlo en planta; escribir un acero aquí sería inventar la procedencia de una pieza que no hemos fabricado.","expresion":"/^FIJO · Volante de horquilla guia_/","reales":10},{"id":"MAT-02","esperadas":5,"dueño":"adapt/mod_tensor2.mjs \(pieza medida del cliente\)","motivo":"misma razón que MAT-01: es la tensora del cliente reutilizada \(step §4.5\).","expresion":"/^FIJO · Polea tensora POL-CON-TEN/","reales":5},{"id":"MAT-03","esperadas":4,"dueño":"adapt/params_tambores.mjs · adapt/mod_tambores.mjs","motivo":"el módulo SÍ declara el material del tubo, del eje y de la pletina de soporte del RODILLO CONDUCIDO, pero no el de sus 2 tapas-soporte ni el de sus 2 casquillos. Son piezas de torno con asiento de rodamiento y prensado H7/r6: el plano no sale sin material. Falta declararlo en params_tambores \(CONDUCIDO.tapa\).\\n      Eran 20 hasta el 05-08-2026: las otras 16 eran las de los 4 rodillos de retorno de POZO, que retira RETIRA_POZO. Sus sustitutos —los 2 rodillos elevadores— son conjunto Hytrol B-20760 COMPRADO, o sea que no piden material de taller sino designación de catálogo, y la tienen.","expresion":"/· \(tapa-soporte|casquillo\) Ø/","reales":4}],"sinMaterialNiDispensa":[],"materialFuentes":{"declarado por su módulo en el campo `material`":78,"params_pg40 GUIA.material \(web UHMW-001\) — es la misma regleta de deslizamiento":5,"params_adapt CALLE.puente \(«dis: pletina A36»\) + el espesor del propio nombre":10,"campo `chapa` de la propia pieza":6,"params_estaciones GUIAS.base.t = 4.763":2,"params_tensor2 PIV.material":1,"params_tensor2 SOPORTE.trav \(«tubo estructural 40×40×3»\) + SOPORTE_CALC.fyMPa 250 = A36":1,"params_tensor2 SOPORTE.mensula.e = 8 \(«dis — pletina A36»\)":2,"params_tensor2 SOPORTE.regPresion.placa \(«dis — pletina»\) + SOPORTE_CALC.fyMPa 250 = A36":1,"la nota que el propio módulo escribe en la pieza: «pletina A36 e=8, corte láser»":10,"la nota del propio módulo: «tubo mecanizado Ø50, bore Ø38 H7». El GRADO del acero no lo declara nadie — queda dicho en el informe":5,"la nota del propio módulo \(«pletina A36 en L»\) + params_tensor2 SOPORTE.mensula.e":5,"params_pg40 PERFIL.aleacion \(web ALU-001 / MAT-6063-01\)":16,"params_pg40 ALARGUE.material":11},"nbt90":{"piezas":284,"conTol":284,"soldadas":23,"conCordon":23,"compradas":246,"designadas":246,"llegaCompleto":true},"huerfanas":[{"id":"B9-a","esperadas":3,"retiradas":3,"supervivientes":0,"expresion":"/^FIJO · Perno hex M8×16 lengüeta \\\\\(/","motivo":"sujetaban la «Placa de cuelgue NBT90 con 3 lengüetas», que la bandera ya retira. Son las 3 únicas piezas del ensamble sin ningún vecino a menos de 1 mm: flotan."},{"id":"B9-b","esperadas":12,"retiradas":12,"supervivientes":0,"expresion":"/^FIJO · Perno hex M8×20 ménsula?bastidor \\\\\(/","motivo":"cosían la «Ménsula percha» y la «Placa frontal ménsula?bastidor» al chapón; las dos están filtradas. Su único vecino que queda es la guarda de pozo ?X, que ATRAVIESAN."},{"id":"B9-c","esperadas":12,"retiradas":12,"supervivientes":0,"expresion":"/^FIJO · \(Perno hex 3\\\\/8-16×[12]\\" cuelgue NBT90|Tuerca hex 3\\\\/8-16 cuelgue|Golilla 3\\\\/8 cuelgue\) \\\\\(/","motivo":"DUPLICADOS: van a las MISMAS colisas de reglaje del side channel \(Y ?802 y ?1145\) que los «PG40 · Perno hex 3/8-16 × 25 · alargue», 8.73 mm por encima \(Z ?104.27 contra ?113\), y el alma del alargue sólo tiene taladro a Z ?113: atraviesan chapa maciza. Dos filas de pernos a 8.73 mm en una colisa de ±8 anulan el reglaje vertical del NBT90."}],"juntas":[{"id":"SLD-01","esperadas":10,"expresion":"/^FIJO · Placa base de puente/","espesorJuntaMm":6,"junta":"placa base 6 mm ? pletina del puente 30×28 — la fina es la placa","fuente":"espesor de la propia placa \(nombre 64×28×6\)","reales":10},{"id":"SLD-02","esperadas":2,"expresion":"/^FIJO · Base de guía \(norte|sur\) 3\\\\/16\\"/","espesorJuntaMm":null,"junta":"alma vertical ? base, las dos de 3/16\\"","fuente":"params_estaciones GUIAS.base.t — el propio `espesorLocal` lo lee del «3/16\\"» del nombre","reales":2},{"id":"SLD-03","esperadas":15,"expresion":"/^FIJO · \(Brazo tensor e=|Cubo del brazo\)/","espesorJuntaMm":6,"junta":"las 2 pletinas del brazo \(e=8\) ? cubo Ø50/Ø38 — la fina es la PARED DEL CUBO, \(50?38\)/2 = 6, no la pletina","fuente":"params_tensor2 PIV.cubo {de:50, bore:38} — calc de la pared","reales":15},{"id":"SLD-04","esperadas":2,"expresion":"/^FIJO · Placa de extremo del travesaño frontal/","espesorJuntaMm":3,"junta":"placa de extremo \(e=8\) ? travesaño 40×40×3 — la fina es la pared del tubo","fuente":"params_tensor2 SOPORTE.trav.esp = 3","reales":2},{"id":"SLD-05","esperadas":2,"expresion":"/^TAMBOR · tapa soldada/","espesorJuntaMm":3.2,"junta":"tapa torneada e=12 ? tubo Ø88.9×3.2 y ? eje Ø35 — la fina es la PARED DEL TUBO","fuente":"params_tambores TAMBOR.tubo.e \(pared del tubo\)","reales":2},{"id":"SLD-06","esperadas":4,"expresion":"/^PG40 · Ménsula alma?travesaño/","espesorJuntaMm":8,"junta":"ménsula ? alma del alargue, solape de dos pletinas del mismo espesor","fuente":"params_pg40 ALARGUE.e","reales":4}]}) Tj ET
