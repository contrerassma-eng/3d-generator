BT /F1 9.07 Tf 68.03 538.47 Td (· fabricacion: {"propias":610,"fabricadas":219,"compradas":391,"conTolerancia":219,"conMaterial":164,"soldadas":35,"conCordon":35,"designadas":391,"deModulo":35,"sinDesignar":[],"avisosDesignacion":68,"genericas":[],"sinNorma":[],"diceSoldadaSinTabla":[],"juntasSinCota":[],"dispensas":[{"id":"MAT-01","esperadas":10,"dueño":"adapt/mod_calles.mjs \(pieza medida del cliente\)","motivo":"volante del cliente REUBICADO: del STEP salen el Ø y la cara útil, no el material. Hay que preguntárselo al cliente o medirlo en planta; escribir un acero aquí sería inventar la procedencia de una pieza que no hemos fabricado.","expresion":"/^FIJO · Volante de horquilla guia_/","reales":10},{"id":"MAT-02","esperadas":5,"dueño":"adapt/mod_tensor2.mjs \(pieza medida del cliente\)","motivo":"misma razón que MAT-01: es la tensora del cliente reutilizada \(step §4.5\).","expresion":"/^FIJO · Polea tensora POL-CON-TEN/","reales":5},{"id":"MAT-03","esperadas":20,"dueño":"adapt/params_tambores.mjs · adapt/mod_tambores.mjs","motivo":"el módulo SÍ declara el material del tubo, del eje y de la pletina de soporte de estos mismos rodillos, pero no el de sus 10 tapas-soporte ni el de sus 10 casquillos. Son piezas de torno con asiento de rodamiento y prensado H7/r6: el plano no sale sin material. Falta declararlo en params_tambores \(CONDUCIDO.tapa y RETORNOS.tapa\).","expresion":"/· \(tapa-soporte|casquillo\) Ø/","reales":20},{"id":"MAT-04","esperadas":14,"dueño":"adapt/params_tensor2.mjs","motivo":"PIV.separador, POL.eje y SOPORTE.bulonRotula declaran cotas pero no material, y a diferencia del eje pivote \(PIV.material = «C45 rectificado h7»\) o del bulón trasero \(«C45 \(1.0503\) rectificado h9 · web MAT-C45-01»\) aquí no hay nada que leer. Los tres van rectificados y con gargantas de anillo: el grado importa.","expresion":"/^FIJO · \(Eje de polea tensora|Bulón del lóbulo|Separador Ø38×\)/","reales":14},{"id":"MAT-05","esperadas":6,"dueño":"adapt/mod_guardas.mjs","motivo":"los 6 casquillos que salvan el gap guarda?chapón. Estaban DESAPARECIENDO del ensamble —se los llevaba la expresión ancha `Casquillo separador` del filtro de la percha— mientras sus 6 pernos M8×25/M8×35 seguían dentro atravesando el hueco vacío. Recuperados; ahora falta su material: ni mod_guardas ni el casquillo de escote de la percha del que copia el patrón declaran ninguno.","expresion":"/^FIJO · Casquillo separador Ø\\\\d+×[\\\\d.]+ guarda /","reales":6}],"sinMaterialNiDispensa":[],"materialFuentes":{"params_adapt CALLE.puente.aceroH \(«dis: pletina A36»\) + el propio nombre, que ya dice A36":5,"params_pg40 GUIA.material \(web UHMW-001\) — es la misma regleta de deslizamiento":5,"params_adapt CALLE.puente \(«dis: pletina A36»\) + el espesor del propio nombre":10,"campo `chapa` de la propia pieza":10,"params_estaciones GUIAS.base.t = 4.763":2,"params_tensor2 PIV.material":1,"params_tensor2 SOPORTE.trav \(«tubo estructural 40×40×3»\) + SOPORTE_CALC.fyMPa 250 = A36":1,"params_tensor2 SOPORTE.mensula.e = 8 \(«dis — pletina A36»\)":2,"params_tensor2 SOPORTE.regPresion.placa \(«dis — pletina»\) + SOPORTE_CALC.fyMPa 250 = A36":1,"la nota que el propio módulo escribe en la pieza: «pletina A36 e=8, corte láser»":10,"la nota del propio módulo: «tubo mecanizado Ø50, bore Ø38 H7». El GRADO del acero no lo declara nadie — queda dicho en el informe":5,"la nota del propio módulo \(«pletina A36 en L»\) + params_tensor2 SOPORTE.mensula.e":5,"declarado por su módulo en el campo `material`":80,"params_pg40 PERFIL.aleacion \(web ALU-001 / MAT-6063-01\)":16,"params_pg40 ALARGUE.material":11},"nbt90":{"piezas":284,"conTol":284,"soldadas":23,"conCordon":23,"compradas":246,"designadas":246,"llegaCompleto":true},"huerfanas":[{"id":"B9-a","esperadas":3,"retiradas":3,"supervivientes":0,"expresion":"/^FIJO · Perno hex M8×16 lengüeta \\\\\(/","motivo":"sujetaban la «Placa de cuelgue NBT90 con 3 lengüetas», que la bandera ya retira. Son las 3 únicas piezas del ensamble sin ningún vecino a menos de 1 mm: flotan."},{"id":"B9-b","esperadas":12,"retiradas":12,"supervivientes":0,"expresion":"/^FIJO · Perno hex M8×20 ménsula?bastidor \\\\\(/","motivo":"cosían la «Ménsula percha» y la «Placa frontal ménsula?bastidor» al chapón; las dos están filtradas. Su único vecino que queda es la guarda de pozo ?X, que ATRAVIESAN."},{"id":"B9-c","esperadas":12,"retiradas":12,"supervivientes":0,"expresion":"/^FIJO · \(Perno hex 3\\\\/8-16×[12]\\" cuelgue NBT90|Tuerca hex 3\\\\/8-16 cuelgue|Golilla 3\\\\/8 cuelgue\) \\\\\(/","motivo":"DUPLICADOS: van a las MISMAS colisas de reglaje del side channel \(Y ?802 y ?1145\) que los «PG40 · Perno hex 3/8-16 × 25 · alargue», 8.73 mm por encima \(Z ?104.27 contra ?113\), y el alma del alargue sólo tiene taladro a Z ?113: atraviesan chapa maciza. Dos filas de pernos a 8.73 mm en una colisa de ±8 anulan el reglaje vertical del NBT90."}],"juntas":[{"id":"SLD-01","esperadas":10,"expresion":"/^FIJO · Placa base de puente/","espesorJuntaMm":6,"junta":"placa base 6 mm ? pletina del puente 30×28 — la fina es la placa","fuente":"espesor de la propia placa \(nombre 64×28×6\)","reales":10},{"id":"SLD-02","esperadas":2,"expresion":"/^FIJO · Base de guía \(norte|sur\) 3\\\\/16\\"/","espesorJuntaMm":null,"junta":"alma vertical ? base, las dos de 3/16\\"","fuente":"params_estaciones GUIAS.base.t — el propio `espesorLocal` lo lee del «3/16\\"» del nombre","reales":2},{"id":"SLD-03","esperadas":15,"expresion":"/^FIJO · \(Brazo tensor e=|Cubo del brazo\)/","espesorJuntaMm":6,"junta":"las 2 pletinas del brazo \(e=8\) ? cubo Ø50/Ø38 — la fina es la PARED DEL CUBO, \(50?38\)/2 = 6, no la pletina","fuente":"params_tensor2 PIV.cubo {de:50, bore:38} — calc de la pared","reales":15},{"id":"SLD-04","esperadas":2,"expresion":"/^FIJO · Placa de extremo del travesaño frontal/","espesorJuntaMm":3,"junta":"placa de extremo \(e=8\) ? travesaño 40×40×3 — la fina es la pared del tubo","fuente":"params_tensor2 SOPORTE.trav.esp = 3","reales":2},{"id":"SLD-05","esperadas":2,"expresion":"/^TAMBOR · tapa soldada/","espesorJuntaMm":3.2,"junta":"tapa torneada e=12 ? tubo Ø88.9×3.2 y ? eje Ø35 — la fina es la PARED DEL TUBO","fuente":"params_tambores TAMBOR.tubo.e \(pared del tubo\)","reales":2},{"id":"SLD-06","esperadas":4,"expresion":"/^PG40 · Ménsula alma?travesaño/","espesorJuntaMm":8,"junta":"ménsula ? alma del alargue, solape de dos pletinas del mismo espesor","fuente":"params_pg40 ALARGUE.e","reales":4}]}) Tj ET
