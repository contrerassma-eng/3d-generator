# Artefactos reproducibles (se regeneran desde las fotos; sus hashes quedan en audit.log)
projects/*/work/

# Fotos de entrada: pesadas para git. Sus SHA-256 quedan en work/00_intake y audit.log.
# Para versionarlas usa git-lfs y elimina estas dos líneas.
projects/*/input/photos/*
!projects/*/input/photos/.gitkeep

# Material web descargado (reproducible: URLs en audit.log y refs/_fuentes.txt)
projects/*/input/video/
projects/*/input/refs/*
!projects/*/input/refs/_fuentes.txt

# Modelos pesados: se versionan los de 70_web (entregable). Si superan ~100 MB usa git-lfs.
projects/*/out/*.ply
projects/*/out/*.mvs

# Salidas de la biblioteca de componentes (se regeneran del catalogo)
componentes/out/

# Zip de entrega: solo empaqueta archivos que ya estan versionados al lado
projects/*/out/**/*_piezas.zip
projects/*/out/**/*_modulo.zip

__pycache__/
*.pyc
.venv/

# STL teselados del STEP y sus colores por triángulo (derivados grandes,
# regenerables con tools/step_to_stl.py + tools/color_step_mesh.py)
cad/ensambles/*.stl
cad/ensambles/*_colors.bin
cad/ensambles/*_remove.bin
cad/ensambles/transfer_animacion_standalone.html

# Dependencias de node para correr los tests/exportadores del CAD (npm i en cad/)
cad/node_modules/

# Avance parcial del NBT90 (se regenera; el ensamble bueno es narrow_belt_transfer_90.json)
cad/ensambles/nbt90/_avance.json
cad/ensambles/nbt90/out/

# Scratch de los agentes de diseño
cad/_tmp_*.mjs

# STEP y GLB derivados: se regeneran con a_step.py / export_glb.mjs en menos de un minuto
cad/ensambles/nbt90/step/
